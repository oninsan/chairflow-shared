{
  "name": "@chairflow/shared",
  "version": "0.1.0",
  "description": "Shared types, theme tokens, and formatters for ChairFlow",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./tokens.css": {
      "style": "./dist/tokens.css",
      "default": "./dist/tokens.css"
    }
  },
  "files": ["dist"],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/oninsan/chairflow-shared.git"
  },
  "scripts": {
    "build": "tsc && node scripts/build-tokens.mjs",
    "build:tokens": "node scripts/build-tokens.mjs",
    "dev": "tsc --watch",
    "lint": "eslint src",
    "check:tokens": "node scripts/check-no-raw-hex.mjs src",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@eslint/js": "^9.27.0",
    "eslint": "^9.27.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.32.1",
    "vitest": "^4.1.7"
  }
}
